<Project>
  <PropertyGroup>
    <DevolutionsPowerShellFfiNativeAsset>$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\devolutions_pwsh_ffi.dll</DevolutionsPowerShellFfiNativeAsset>
  </PropertyGroup>

  <Target Name="RemoveDevolutionsPowerShellFfiNativeCopyLocalAsset"
          AfterTargets="ResolveLockFileCopyLocalFiles"
          Condition="'$(DevolutionsPowerShellFfiEnabled)' != 'true'">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
                            Condition="'%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)' == 'devolutions_pwsh_ffi.dll'" />
      <_ResolvedCopyLocalBuildAssets Remove="@(_ResolvedCopyLocalBuildAssets)"
                                     Condition="'%(_ResolvedCopyLocalBuildAssets.Filename)%(_ResolvedCopyLocalBuildAssets.Extension)' == 'devolutions_pwsh_ffi.dll'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'devolutions_pwsh_ffi.dll'" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveDevolutionsPowerShellFfiPublishedAsset"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(DevolutionsPowerShellFfiEnabled)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'devolutions_pwsh_ffi.dll'" />
    </ItemGroup>
  </Target>

  <Target Name="ResolveDevolutionsPowerShellFfiNativeAsset"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(DevolutionsPowerShellFfiEnabled)' == 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64'"
           Text="Devolutions.PowerShell.Ffi is currently packaged only for win-x64. Set RuntimeIdentifier to win-x64 or remove DevolutionsPowerShellFfiEnabled." />
    <Error Condition="!Exists('$(DevolutionsPowerShellFfiNativeAsset)')"
           Text="The packaged devolutions_pwsh_ffi native asset was not found." />
    <Copy SourceFiles="$(DevolutionsPowerShellFfiNativeAsset)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishDevolutionsPowerShellFfiNativeAsset"
          AfterTargets="Publish"
          Condition="'$(DevolutionsPowerShellFfiEnabled)' == 'true'">
    <Copy SourceFiles="$(DevolutionsPowerShellFfiNativeAsset)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
