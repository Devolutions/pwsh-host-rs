<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Devolutions.MultiPwsh.Sdk</AssemblyName>
    <PackageId>Devolutions.MultiPwsh.Sdk</PackageId>
    <PackageVersion Condition="'$(PackageVersion)' == ''">0.14.2</PackageVersion>
    <Authors>Devolutions</Authors>
    <Description>Experimental hash-pinned PowerShell payload facade for the in-process NativeAOT Devolutions Rust FFI.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/Devolutions/multi-pwsh</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>PowerShell;NativeAOT;FFI;experimental</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>win-x64 only. Native deployment is opt-in. PowerShell is not included; activation requires a hash-pinned payload manifest.</PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..</RepositoryRoot>
    <PwshFfiCargoProfile Condition="'$(PwshFfiCargoProfile)' == ''">ffi-release</PwshFfiCargoProfile>
    <PwshFfiRustFlags Condition="'$(RUSTFLAGS)' == ''">-C target-feature=+crt-static</PwshFfiRustFlags>
    <PwshFfiRustFlags Condition="'$(RUSTFLAGS)' != ''">$(RUSTFLAGS) -C target-feature=+crt-static</PwshFfiRustFlags>
    <PwshFfiNativeLibrary Condition="'$(PwshFfiNativeLibrary)' == ''">$(RepositoryRoot)\target\$(PwshFfiCargoProfile)\multi_pwsh_sdk.dll</PwshFfiNativeLibrary>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="buildTransitive\Devolutions.MultiPwsh.Sdk.targets"
          Pack="true"
          PackagePath="buildTransitive\" />
    <None Include="devolutions-pwsh-payload.manifest.template.json"
          Pack="true"
          PackagePath="contentFiles\any\any\"
          Visible="false" />
    <None Include="$(PwshFfiNativeLibrary)"
          Pack="true"
          PackagePath="runtimes\win-x64\native\multi-pwsh-sdk.dll"
          Visible="false" />
  </ItemGroup>

  <Target Name="BuildPwshFfiNativeAsset"
          BeforeTargets="GenerateNuspec"
          Condition="'$(BuildPwshFfiNativeAsset)' != 'false'">
    <Exec Command="cargo build --profile $(PwshFfiCargoProfile) -p devolutions-pwsh-ffi"
          WorkingDirectory="$(RepositoryRoot)"
          EnvironmentVariables="RUSTFLAGS=$(PwshFfiRustFlags)" />
  </Target>
</Project>
