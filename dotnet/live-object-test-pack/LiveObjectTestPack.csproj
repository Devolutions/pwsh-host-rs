<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Devolutions.MultiPwsh.LiveObject.TestPack</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contract packs are loaded from native memory, so link the small shared
         contract source instead of introducing an unresolvable assembly dependency. -->
    <Compile Include="..\live-contracts\LiveContractAttributes.cs"
             Link="LiveContractAttributes.cs" />
    <Compile Include="..\live-contracts\LiveContractBroker.cs"
             Link="LiveContractBroker.cs" />
    <Compile Include="..\interop\PowerShellLiveObjectContract.cs"
             Link="PowerShellLiveObjectContract.cs" />
    <Compile Include="..\interop\PowerShellLiveObjectTestContract.cs"
             Link="PowerShellLiveObjectTestContract.cs" />
    <Compile Include="..\interop\SessionCreatorLiveContract.cs"
             Link="SessionCreatorLiveContract.cs" />
    <ProjectReference Include="..\live-contract-generator\Devolutions.MultiPwsh.LiveContract.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <LiveContractMode>Payload</LiveContractMode>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="LiveContractMode" />
  </ItemGroup>
</Project>
